# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and will never be committed.

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# (Optional) Hugging Face token — silences download warnings, speeds up Kokoro
# Get one free at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# OpenWeatherMap API key — free at https://home.openweathermap.org/api_keys
# NOTE: new keys take 10 minutes to 2 hours to activate.
OPENWEATHER_API_KEY=your_openweather_api_key_here